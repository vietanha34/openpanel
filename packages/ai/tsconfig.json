{
  "extends": "@openpanel/tsconfig/base.json",
  "compilerOptions": {
    // TypeScript 7 no longer pulls every @types package into the program on its
    // own, and this one reaches for Node globals.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "strictNullChecks": true
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
