exports[`existing chart segments compile to unchanged SQL > getAggregateChartSql group 1`] = `"WITH _g AS (SELECT id, name, type, properties FROM groups FINAL WHERE project_id = 'test-chart-segment-sql')  SELECT 'level_start' as label_0, '2026-04-14 00:00:00' as date, countDistinct(_group_id) as count FROM events e ARRAY JOIN groups AS _group_id LEFT ANY JOIN _g ON _g.id = _group_id WHERE (e.properties['level_mode'] = 'hard') AND (project_id = 'test-chart-segment-sql') AND (e.name = 'level_start') AND (created_at >= toDateTime('2026-04-14 00:00:00')) AND (created_at <= toDateTime('2026-05-15 00:00:00')) GROUP BY label_0 ORDER BY count DESC"`;

