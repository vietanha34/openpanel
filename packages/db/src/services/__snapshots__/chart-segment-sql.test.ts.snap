exports[`existing chart segments compile to unchanged SQL > getChartSql event 1`] = `"SELECT * EXCEPT (_uc_state), uniqMerge(_uc_state) OVER () as total_count FROM (SELECT 'level_start' as label_0, count(*) as count, toStartOfDay(created_at) as date, uniqState(profile_id) as _uc_state FROM events e  WHERE (e.properties['level_mode'] = 'hard') AND (project_id = 'test-chart-segment-sql') AND (e.name = 'level_start') AND (created_at >= toDateTime('2026-04-14 00:00:00')) AND (created_at <= toDateTime('2026-05-15 00:00:00')) GROUP BY date) ORDER BY date ASC WITH FILL FROM toStartOfDay(toDateTime('2026-04-14 00:00:00')) TO toStartOfDay(toDateTime('2026-05-15 00:00:00')) STEP toIntervalDay(1)"`;

exports[`existing chart segments compile to unchanged SQL > getChartSql event/country 1`] = `"SELECT * EXCEPT (_uc_state), uniqMerge(_uc_state) OVER (PARTITION BY label_1) as total_count FROM (SELECT 'level_start' as label_0, count(*) as count, toStartOfDay(created_at) as date, country as label_1, uniqState(profile_id) as _uc_state FROM events e  WHERE (e.properties['level_mode'] = 'hard') AND (project_id = 'test-chart-segment-sql') AND (e.name = 'level_start') AND (created_at >= toDateTime('2026-04-14 00:00:00')) AND (created_at <= toDateTime('2026-05-15 00:00:00')) GROUP BY date, label_1) ORDER BY date ASC WITH FILL FROM toStartOfDay(toDateTime('2026-04-14 00:00:00')) TO toStartOfDay(toDateTime('2026-05-15 00:00:00')) STEP toIntervalDay(1)"`;

