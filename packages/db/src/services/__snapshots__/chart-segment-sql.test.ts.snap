exports[`existing chart segments compile to unchanged SQL > getAggregateChartSql one_event_per_user 1`] = `
"SELECT 'level_start' as label_0, '2026-04-14 00:00:00' as date, count(*) as count FROM (
      SELECT DISTINCT ON (profile_id) * from events e  WHERE e.properties['level_mode'] = 'hard' AND project_id = 'test-chart-segment-sql' AND e.name = 'level_start' AND created_at >= toDateTime('2026-04-14 00:00:00') AND created_at <= toDateTime('2026-05-15 00:00:00')
        ORDER BY profile_id, created_at DESC
      ) as subQuery WHERE (e.properties['level_mode'] = 'hard') AND (project_id = 'test-chart-segment-sql') AND (e.name = 'level_start') AND (created_at >= toDateTime('2026-04-14 00:00:00')) AND (created_at <= toDateTime('2026-05-15 00:00:00')) GROUP BY label_0"
`;

