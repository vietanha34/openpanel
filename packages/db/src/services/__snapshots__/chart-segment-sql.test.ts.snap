exports[`existing chart segments compile to unchanged SQL > getAggregateChartSql event 1`] = `"SELECT 'level_start' as label_0, '2026-04-14 00:00:00' as date, count(*) as count FROM events e WHERE (e.properties['level_mode'] = 'hard') AND (project_id = 'test-chart-segment-sql') AND (e.name = 'level_start') AND (created_at >= toDateTime('2026-04-14 00:00:00')) AND (created_at <= toDateTime('2026-05-15 00:00:00')) GROUP BY label_0 ORDER BY count DESC"`;

